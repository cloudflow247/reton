APP_NAME=Reton
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker / production-style (PostgreSQL + Redis)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reton
DB_USERNAME=reton
DB_PASSWORD=secret

# Native Windows PHP (no Docker) — uncomment this block instead:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# QUEUE_CONNECTION=database
# CACHE_STORE=file
# SESSION_DRIVER=file
# REDIS_HOST=127.0.0.1

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://127.0.0.1:5173

# ── Laravel Reverb (WebSockets) ──────────────────────────────────────
REVERB_APP_ID=reton
REVERB_APP_KEY=reton-key
REVERB_APP_SECRET=reton-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Laravel Horizon ──────────────────────────────────────────────────
HORIZON_PATH=horizon
# Comma-separated admin emails allowed to view Horizon outside local.
HORIZON_ALLOWED_EMAILS=

# ── ALATPay (Wema) payment gateway ───────────────────────────────────
# driver: "http" (live API) or a test/fake driver. Provide keys for live.
ALATPAY_DRIVER=http
ALATPAY_BASE_URL=https://api.alatpay.ng
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=
ALATPAY_BUSINESS_BVN=
ALATPAY_WEBHOOK_SECRET=
ALATPAY_TIMEOUT=15

# ── Reton app config ─────────────────────────────────────────────────
RETON_DEFAULT_CURRENCY=NGN
# Demo accounts on the sign-in screen — keep OFF in production.
RETON_DEMO_MODE=false
RETON_DEMO_PASSWORD=demo1234
RETON_DEMO_PIN=1234
# Canonical origin for share links (WhatsApp, QR). Use production domain in prod.
RETON_PUBLIC_URL=
RETON_LISTING_PATH=/l
RETON_APP_SCHEME=reton
# Mobile deep linking — set when iOS/Android apps ship
# RETON_IOS_BUNDLE_ID=ng.reton.app
# RETON_APPLE_TEAM_ID=
# RETON_ANDROID_PACKAGE=ng.reton.app
# RETON_ANDROID_SHA256=
