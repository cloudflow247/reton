APP_NAME=Reton
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker / production-style (PostgreSQL + Redis)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reton
DB_USERNAME=reton
DB_PASSWORD=secret

# Native Windows PHP (no Docker) — uncomment this block instead:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# QUEUE_CONNECTION=database
# CACHE_STORE=file
# SESSION_DRIVER=file
# REDIS_HOST=127.0.0.1
# ALATPAY_DRIVER=fake
REMITA_DRIVER=fake
# RETON_DEMO_MODE=true
# RETON_DEMO_PASSWORD=demo1234
# RETON_DEMO_PIN=1234
# APP_URL=http://127.0.0.1:8000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://127.0.0.1:5173

# ── Laravel Reverb (WebSockets) ──────────────────────────────────────
REVERB_APP_ID=reton
REVERB_APP_KEY=reton-key
REVERB_APP_SECRET=reton-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Laravel Horizon ──────────────────────────────────────────────────
HORIZON_PATH=horizon
# Comma-separated admin emails allowed to view Horizon outside local.
HORIZON_ALLOWED_EMAILS=

# ── ALATPay (Wema) payment gateway ───────────────────────────────────
# Integration keys can be set in the admin panel (/admin) after promoting
# your account: php artisan reton:admin your@email.com
# Values are encrypted in the database — safe for public GitHub repos.
# Env vars below are optional fallbacks for CI/local; leave empty in production.
ALATPAY_DRIVER=fake
ALATPAY_BASE_URL=https://apibox.alatpay.ng
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=
ALATPAY_BUSINESS_BVN=
ALATPAY_WEBHOOK_SECRET=
ALATPAY_TIMEOUT=15

# Dojah — BVN / NIN identity verification (sandbox free; production is prepaid)
DOJAH_DRIVER=fake
DOJAH_BASE_URL=https://sandbox.dojah.io
# Production: DOJAH_DRIVER=http and DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_TIMEOUT=20

# ── Reton app config ─────────────────────────────────────────────────
# Most RETON_* values can be managed in the admin panel (Platform / App /
# Integrations). Env vars below are fallbacks until saved in the dashboard.
# Infrastructure (DB, Redis, APP_KEY, Reverb) must stay in env.
RETON_DEFAULT_CURRENCY=NGN
# Demo accounts on the sign-in screen — keep OFF in production.
RETON_DEMO_MODE=false
RETON_DEMO_PASSWORD=demo1234
RETON_DEMO_PIN=1234
# Canonical origin for share links (WhatsApp, QR). Use production domain in prod.
RETON_PUBLIC_URL=
# Secret admin panel path segment (customize in admin → App settings).
RETON_ADMIN_PATH=admin
RETON_LISTING_PATH=/l
RETON_APP_SCHEME=reton
# Mobile deep linking — set when iOS/Android apps ship
# RETON_IOS_BUNDLE_ID=ng.reton.app
# RETON_APPLE_TEAM_ID=
# RETON_ANDROID_PACKAGE=ng.reton.app
# RETON_ANDROID_SHA256=

# Email, SEO, and security — override via admin → Site until saved in dashboard.
RETON_MAIL_NOTIFICATIONS_ENABLED=true
RETON_MAIL_FROM_ADDRESS=support@retonpay.com
RETON_MAIL_FROM_NAME=Reton
RETON_MAIL_SUPPORT_ADDRESS=support@retonpay.com
RETON_MAIL_REPLY_TO=support@retonpay.com
# RETON_MAIL_MAILER=smtp
# RETON_MAIL_SMTP_HOST=
# RETON_MAIL_SMTP_PORT=587
# RETON_MAIL_SMTP_USERNAME=
# RETON_MAIL_SMTP_PASSWORD=
RETON_SEO_SITE_NAME=Reton
RETON_SEO_TITLE="Reton — payments you can take back"
RETON_SEO_OG_IMAGE=/og-banner.png
RETON_SECURITY_CSP_REPORT_ONLY=true
RETON_SECURITY_AUTH_RATE_LIMIT=10

# ── Interswitch Quickteller (bill payments & airtime) ────────────────
# Configure via admin panel (/admin/integrations) in production.
# Docs: https://docs.interswitchgroup.com/docs/bills-payment-1
RETON_BILL_PROVIDER=interswitch
INTERSWITCH_DRIVER=fake
INTERSWITCH_PASSPORT_URL=https://passport.interswitchng.com/passport/oauth/token
INTERSWITCH_BASE_URL=https://interswitchng.com/quicktellerservice/api/v5
INTERSWITCH_CARDS_BASE_URL=https://sandbox.interswitchng.com
INTERSWITCH_CARD_CREATE_PIN=1234
INTERSWITCH_TERMINAL_ID=
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
INTERSWITCH_REF_PREFIX=1453
INTERSWITCH_TIMEOUT=15

# ── Giglogistics (physical marketplace) ──────────────────────────────
# Configure via admin panel (/admin/integrations) in production.
GIGLOGISTICS_DRIVER=fake
GIGLOGISTICS_BASE_URL=https://api.giglogistics.com
GIGLOGISTICS_API_KEY=
# HMAC secret for POST /api/v1/webhooks/giglogistics (X-Giglogistics-Signature)
GIGLOGISTICS_WEBHOOK_SECRET=
# Minutes between fake gateway stage advances (0 = one stage per poll in tests)
GIGLOGISTICS_FAKE_ADVANCE_MINUTES=1
# Physical escrow: hours buyer has to confirm after delivery
# RETON_PHYSICAL_CONFIRM_HOURS=72
